{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts & vite",
    "dev:web": "vite",
    "dev:server": "bun --watch server.ts",
    "build": "vite build",
    "generate-fsdata": "bun scripts/generate-fsdata.ts",
    "build:device": "bun run build && bun run generate-fsdata",
